{%- comment -%}
  Star rating — Figma 10066:70–74: 13px Ivory stars on a 13px pitch, the last
  one cut to show the fraction (4.5 → 4 full + a half). No outline for the
  unearned remainder, as drawn.

  Static for now: the product section passes a merchant-set value. To wire up
  reviews later, pass the review app's value instead, e.g.
  {% render 'wc-rating', value: product.metafields.reviews.rating.value.rating %}

  Accepts:
  - value: {Number} 0–5
  - max: {Number} optional, default 5
{%- endcomment -%}

{%- liquid
  assign rating_max = max | default: 5
  assign rating_value = value | default: 0 | at_most: rating_max | at_least: 0
  assign rating_percent = rating_value | times: 100.0 | divided_by: rating_max
-%}

<span class="wc-rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max | escape }}">
  <span class="wc-rating__stars" style="--rating-fill: {{ rating_percent }}%;" aria-hidden="true">
    {%- for i in (1..rating_max) -%}
      <svg class="wc-rating__star" viewBox="0 0 13 13" focusable="false">
        <path d="M6.5.6l1.77 3.83 4.18.46-3.1 2.87.83 4.13L6.5 9.8l-3.68 2.09.83-4.13-3.1-2.87 4.18-.46z" fill="currentColor"/>
      </svg>
    {%- endfor -%}
  </span>
</span>
