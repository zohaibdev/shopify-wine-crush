{{ 'wc-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'wordmark'
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
-%}

<section
  class="wc-hero wc-hero--{{ section.settings.desktop_height }} wc-hero--{{ layout }}"
  style="--overlay-hero: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"
>
  <div class="wc-hero__media">
    {%- if has_video -%}
      {{
        section.settings.video
        | video_tag:
          image_size: '1920x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          poster: section.settings.image
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag: widths: '750, 1100, 1440, 1920, 2400, 3000', fetchpriority: 'high', sizes: '100vw', alt: ''
      }}
    {%- else -%}
      {%- comment -%} Each layout ships with the art it was drawn with. {%- endcomment -%}
      {%- assign fallback_art = 'wine-crush-hero.jpg' -%}
      {%- if layout == 'heading' -%}
        {%- assign fallback_art = 'wine-crush-about-hero.jpg' -%}
      {%- endif -%}
      <img
        src="{{ fallback_art | asset_url }}"
        alt=""
        width="1440"
        height="898"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  {%- if section.settings.lede != blank -%}
    <div class="wc-hero__lede wc-lede">{{ section.settings.lede }}</div>
  {%- endif -%}

  {%- if layout == 'heading' -%}
    {%- comment -%}
      Page variant (About Us, Figma 10058:642): an eyebrow and the page's h1 in
      place of the wordmark, straddling the band edge the same way.
    {%- endcomment -%}
    <div class="wc-hero__title">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wc-hero__eyebrow wc-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="wc-hero__heading">{{ section.settings.heading | default: page.title | escape }}</h1>
    </div>
  {%- else -%}
    {%- comment -%}
      The setting is authored in pixels against the 1440 artboard but emitted as a
      share of the hero width, so the wordmark keeps its proportions at any size.
    {%- endcomment -%}
    {%- assign wordmark_share = section.settings.wordmark_width | times: 100.0 | divided_by: 1440.0 -%}
    <div class="wc-hero__wordmark" style="--wordmark-width: {{ wordmark_share }}%;">
      {%- if section.settings.wordmark != blank -%}
        {{
          section.settings.wordmark
          | image_url: width: 1412
          | image_tag: widths: '353, 706, 1059, 1412', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'wine-crush-logo.svg' | asset_url }}"
          alt="{{ shop.name }}"
          width="706"
          height="174"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    The claret band rises over the bottom of the image and carries the page
    surface up behind the wordmark. Drawn as a pseudo-element on the section.
  {%- endcomment -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "wc-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Also used as the video poster and as the fallback when no video is set."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted and looped with no controls. Takes priority over the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Height",
      "options": [
        { "value": "ratio", "label": "Design ratio" },
        { "value": "screen", "label": "Full screen" }
      ],
      "default": "ratio"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "wordmark", "label": "Wordmark (home)" },
        { "value": "heading", "label": "Page heading" }
      ],
      "default": "wordmark",
      "info": "Page heading swaps the wordmark for an eyebrow and the page title. Each layout has its own placeholder image until one is chosen."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Page heading layout only.",
      "default": "about wine crush"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Page heading layout only. Leave blank to use the page title.",
      "default": "A different kind of bottle shop."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Intro text",
      "default": "<p>Natural wine, chosen by people who drink it.</p>"
    },
    {
      "type": "image_picker",
      "id": "wordmark",
      "label": "Wordmark"
    },
    {
      "type": "range",
      "id": "wordmark_width",
      "label": "Wordmark width",
      "min": 600,
      "max": 800,
      "step": 2,
      "unit": "px",
      "default": 706
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
