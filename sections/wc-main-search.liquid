{%- comment -%}
  Search. Shopify's native search (`/search?q=`), rendered with the theme's
  own components: products use the collection card, articles and pages use
  the Journal card and a plain list. Nothing here is hardcoded.
{%- endcomment -%}

{{ 'wc-product-card.css' | asset_url | stylesheet_tag }}
{{ 'wc-collection.css' | asset_url | stylesheet_tag }}
{{ 'wc-card-grid.css' | asset_url | stylesheet_tag }}
{{ 'wc-form.css' | asset_url | stylesheet_tag }}
{{ 'wc-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  class="wc-page wc-search"
  style="
    --page-padding-top: {{ section.settings.padding_top }}px;
    --page-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="wc-container">
    <div class="wc-search__head">
      <h1 class="wc-page__title">{{ section.settings.heading | escape }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="wc-search__form">
        <label class="wc-visually-hidden" for="SearchInput-{{ section.id }}">
          {{- 'general.search.search' | t -}}
        </label>
        <input
          type="search"
          id="SearchInput-{{ section.id }}"
          class="wc-field__input wc-search__input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.placeholder | escape }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="wc-button wc-search__submit">{{ 'general.search.search' | t }}</button>
      </form>

      {%- if search.performed -%}
        <p class="wc-search__count wc-caption" role="status">
          {%- if search.results_count == 0 -%}
            {{ 'templates.search.no_results' | t: terms: search.terms }}
          {%- else -%}
            {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        <ul class="wc-search__results wc-collection__grid" role="list">
          {%- for item in search.results -%}
            <li class="wc-search__item wc-collection__item">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {%- render 'wc-product-card',
                    product: item,
                    section_id: section.id,
                    layout: 'grid',
                    add_label: section.settings.add_label
                  -%}
                {%- when 'article' -%}
                  {%- render 'wc-article-card', article: item, show_date: true -%}
                {%- else -%}
                  <a class="wc-search__page" href="{{ item.url }}">
                    <span class="wc-search__page-kind wc-caption">{{ item.object_type }}</span>
                    <span class="wc-search__page-title">{{ item.title | escape }}</span>
                  </a>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="wc-pagination" aria-label="{{ 'general.pagination.label' | t | escape }}">
                            <ul class="wc-pagination__list" role="list">
                              {%- if paginate.previous -%}
                                <li>
                                  <a
                                    href="{{ paginate.previous.url }}"
                                    class="wc-pagination__step wc-pagination__step--prev"
                                    aria-label="{{ 'general.pagination.previous' | t | escape }}"
                                  >
                                    {{- 'icon-wc-arrow.svg' | inline_asset_content -}}
                                  </a>
                                </li>
                              {%- endif -%}

                              {%- for part in paginate.parts -%}
                                <li>
                                  {%- if part.is_link -%}
                                    <a
                                      href="{{ part.url }}"
                                      class="wc-pagination__page"
                                      aria-label="{{ 'general.pagination.page' | t: number: part.title | escape }}"
                                    >
                                      {{- part.title -}}
                                    </a>
                                  {%- elsif part.title == paginate.current_page -%}
                                    <span
                                      class="wc-pagination__page is-current"
                                      aria-current="page"
                                      aria-label="{{ 'general.pagination.page' | t: number: part.title | escape }}"
                                    >
                                      {{- part.title -}}
                                    </span>
                                  {%- else -%}
                                    <span class="wc-pagination__gap" aria-hidden="true">{{ part.title }}</span>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}

                              {%- if paginate.next -%}
                                <li>
                                  <a
                                    href="{{ paginate.next.url }}"
                                    class="wc-pagination__step"
                                    aria-label="{{ 'general.pagination.next' | t | escape }}"
                                  >
                                    {{- 'icon-wc-arrow.svg' | inline_asset_content -}}
                                  </a>
                                </li>
                              {%- endif -%}
                            </ul>
                          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- elsif search.performed -%}
      <p class="wc-search__empty wc-body-m">{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "wc-search-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "wine, beer and beyond"
    },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "No results text",
      "default": "<p>Nothing matched that. Try a grape, a region or a producer — or browse the whole collection.</p>"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Product card add label",
      "default": "add"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 102
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 300,
      "step": 3,
      "unit": "px",
      "default": 162
    }
  ]
}
{% endschema %}

