{{ 'wc-card-grid.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'marquee' -%}
  <script src="{{ 'wc-marquee.js' | asset_url }}" defer="defer"></script>
{%- endif %}

{%- liquid
  assign use_blog = false
  if section.settings.source == 'blog' and section.settings.blog != blank
    assign use_blog = true
    assign source_blog = blogs[section.settings.blog]
  endif

  assign item_count = section.blocks.size
  if use_blog
    assign item_count = source_blog.articles.size
  endif

  comment
    A store with no articles (or a merchant who has not added image blocks yet)
    would otherwise render an empty grid, which hides the layout in the theme
    editor and on a fresh install. The bundled art directs the placeholders.
  endcomment
  assign placeholder_count = section.settings.items_to_show
  if use_blog == false
    assign placeholder_count = 4
  endif
-%}

{%- capture cards_markup -%}
  {%- if item_count == 0 -%}
    {%- for i in (1..placeholder_count) -%}
      {%- assign art = i | modulo: 4 | plus: 1 -%}
      <li class="wc-card-grid__item">
        <span class="wc-card">
          <span class="wc-card__media">
            <img
              src="{{ 'wine-crush-blog-' | append: art | append: '.jpg' | asset_url }}"
              alt=""
              width="339"
              height="498"
              loading="lazy"
            >
          </span>
          <span class="wc-card__caption">
            {%- if use_blog and section.settings.show_date -%}
              <span class="wc-card__pill wc-caption">{{ 'now' | date: format: 'abbreviated_date' }}</span>
            {%- endif -%}
            <span class="wc-card__title">{{ 'onboarding.card_title' | t }}</span>
          </span>
        </span>
      </li>
    {%- endfor -%}
  {%- elsif use_blog -%}
    {%- for article in source_blog.articles limit: section.settings.items_to_show -%}
      <li class="wc-card-grid__item">
        {%- render 'wc-article-card', article: article, show_date: section.settings.show_date -%}
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for block in section.blocks -%}
      <li class="wc-card-grid__item" {{ block.shopify_attributes }}>
        <a class="wc-card" href="{{ block.settings.link | default: routes.root_url }}">
          <span class="wc-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 678
                | image_tag: widths: '339, 508, 678', sizes: '(min-width: 990px) 339px, 70vw', alt: ''
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </span>
          {%- if block.settings.label != blank or block.settings.title != blank -%}
            <span class="wc-card__caption">
              {%- if block.settings.label != blank -%}
                <span class="wc-card__pill wc-caption">{{ block.settings.label }}</span>
              {%- endif -%}
              <span class="wc-card__title">{{ block.settings.title }}</span>
            </span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign is_marquee = false
  if section.settings.layout == 'marquee'
    assign is_marquee = true
  endif

  comment
    The script measures the real set width and sets a constant px/s speed. This
    fallback (one 339 card plus its 16 gap per card) is what runs until then,
    and is close enough at desktop that the handover is not visible.
  endcomment
  assign rendered_count = item_count
  if item_count == 0
    assign rendered_count = placeholder_count
  elsif use_blog and item_count > section.settings.items_to_show
    assign rendered_count = section.settings.items_to_show
  endif
  assign marquee_fallback = rendered_count | times: 355 | divided_by: section.settings.marquee_speed
-%}

<section
  class="wc-card-grid{% if is_marquee %} wc-card-grid--marquee{% endif %}"
  style="--grid-padding-top: {{ section.settings.padding_top }}px; --grid-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.heading != blank -%}
    <div class="wc-container">
      <h2 class="wc-card-grid__heading wc-display-m">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if is_marquee -%}
    <wc-marquee
      class="wc-marquee"
      data-speed="{{ section.settings.marquee_speed }}"
      {% if section.settings.marquee_pause_on_hover %}
        data-pause-on-hover
      {% endif %}
      style="--marquee-duration: {{ marquee_fallback | at_least: 1 }}s; --marquee-direction: {% if section.settings.marquee_direction == 'right' %}reverse{% else %}normal{% endif %};"
    >
      <div class="wc-marquee__track">
        <ul class="wc-marquee__group" role="list">
          {{- cards_markup -}}
        </ul>
        {%- comment -%}
          The second copy exists only so the loop has no seam. It is hidden from
          assistive tech and the tab order, so each card is announced once.
        {%- endcomment -%}
        <ul class="wc-marquee__group" role="list" aria-hidden="true" inert>
          {{- cards_markup | replace: 'data-shopify-editor-block', 'data-wc-copy' -}}
        </ul>
      </div>
    </wc-marquee>
  {%- else -%}
    <div class="wc-container">
      <ul class="wc-card-grid__list" role="list">
        {{- cards_markup -}}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Card grid",
  "tag": "div",
  "class": "wc-card-grid-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rail", "label": "Row" },
        { "value": "marquee", "label": "Marquee" }
      ],
      "default": "rail",
      "info": "Marquee scrolls the cards continuously in a seamless loop."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Content from",
      "options": [
        { "value": "blog", "label": "Blog articles" },
        { "value": "blocks", "label": "Images" }
      ],
      "default": "blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show article date",
      "default": true
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40,
      "info": "Pixels per second."
    },
    {
      "type": "checkbox",
      "id": "marquee_pause_on_hover",
      "label": "Pause on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 102
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 102
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Pill label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Card grid"
    }
  ]
}
{% endschema %}
