{{ 'wc-membership.css' | asset_url | stylesheet_tag }}

<section
  class="wc-membership"
  style="--membership-padding-top: {{ section.settings.padding_top }}px; --membership-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="wc-container">
    <div class="wc-membership__stack">
      {%- comment -%}
        The coral panel is narrower and sits 27px higher, so all that shows is a
        coloured lip above the sorbet panel. It is drawn as a pseudo-element on
        the stack because Dawn's base.css hides every empty div.
      {%- endcomment -%}
      <div class="wc-membership__panel">
        <div class="wc-membership__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="wc-membership__heading wc-display-l">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="wc-membership__body wc-body-s rte" style="--membership-body-width: {{ section.settings.body_width }}px;">
              {{ section.settings.body }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ section.settings.button_link | default: routes.root_url }}"
              class="wc-button wc-button--on-light wc-membership__cta"
            >
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
        </div>

        <div class="wc-membership__media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1430
              | image_tag: widths: '715, 1073, 1430', sizes: '(min-width: 990px) 51vw, 100vw', alt: ''
            }}
          {%- else -%}
            <img src="{{ 'wine-crush-5-off-for-life.jpg' | asset_url }}" alt="" width="715" height="759" loading="lazy">
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Membership",
  "tag": "div",
  "class": "wc-membership-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "5% off for life"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Join the club and every bottle you buy is 5% off, forever. No subscription, no minimum.</p>"
    },
    {
      "type": "range",
      "id": "body_width",
      "label": "Body width",
      "min": 246,
      "max": 446,
      "step": 2,
      "unit": "px",
      "default": 346
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "become a member"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 162
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 156
    }
  ],
  "presets": [
    {
      "name": "Membership"
    }
  ]
}
{% endschema %}
